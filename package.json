{
  "name": "portfoliov2",
  "version": "0.0.0",
  "private": true,
  "description": "Grégoire Tinnes's portfolio: a static Astro site with Three.js scenes.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "astro sync && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "budgets": "node scripts/budgets.ts",
    "optimize-media": "node scripts/optimize-media.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.4.2",
    "remark-directive": "^4.0.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "mdast-util-directive": "^3.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
