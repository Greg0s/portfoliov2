{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --port 4322 --ignore-lock",
      "startServerReadyPattern": "localhost:4322",
      "url": [
        "http://localhost:4322/portfoliov2/",
        "http://localhost:4322/portfoliov2/en/",
        "http://localhost:4322/portfoliov2/projets/la-fabrique-des-mondes/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
