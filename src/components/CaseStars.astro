---
/**
 * The few stars behind a case study, placed as in the mockup (a fixed draw of 50, below the cover). They twinkle in
 * three groups, each fading as one layer, so that the page animates three layers rather than fifty stars.
 */
const GROUPS = 3;

let seed = 11;
// The mockup's mulberry32, so that the stars sit where they sit in the mockup.
function random(): number {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
}

const stars = Array.from({ length: 50 }, (_, index) => {
  const big = random() < 0.1;
  const x = random() * 100;
  const y = Math.round(700 + random() * 3600);
  const size = big ? 2 + random() * 1.2 : 1 + random() * 1;
  const alpha = 0.3 + random() * 0.55;
  return { group: index % GROUPS, x, y, size, alpha };
});
const groups = Array.from({ length: GROUPS }, (_, group) => stars.filter((star) => star.group === group));
---

<div class="stars" aria-hidden="true">
  {groups.map((group, index) => (
    <div class="group" style={`--duration: ${String(3 + index * 1.7)}s; --delay: -${String(index * 2.3)}s`}>
      {group.map(({ x, y, size, alpha }) => (
        <span
          style={`left: ${x.toFixed(2)}%; top: ${String(y)}px; width: ${size.toFixed(1)}px; height: ${size.toFixed(1)}px; opacity: ${alpha.toFixed(2)}`}
        />
      ))}
    </div>
  ))}
</div>

<style>
  .stars,
  .group {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .group {
    animation: twinkle var(--duration) var(--ease-float) var(--delay) infinite alternate;
  }

  span {
    position: absolute;
    border-radius: 50%;
    background: #fff;
  }

  @keyframes twinkle {
    from {
      opacity: 1;
    }

    to {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .group {
      animation: none;
    }
  }
</style>
