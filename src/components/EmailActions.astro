---
/**
 * The email and its two actions (office spec §6): the address opens the mail app (`mailto:`); the round button on its
 * right copies it, its icon turning into a check for 1.8 s, and screen readers hear "Address copied". The button needs
 * JavaScript, so it stays hidden without it.
 */
import { config } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale);
---

<div class="email" data-email={config.email} data-copied-text={label('contact.copied')}>
  <a href={`mailto:${config.email}`}>{config.email}</a>
  <button type="button" class="copy" aria-label={label('contact.copy')} hidden>
    <svg class="icon-copy" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <rect x="6.5" y="6.5" width="9.5" height="9.5" rx="2"></rect>
      <path d="M12 6.5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2.5"></path>
    </svg>
    <svg class="icon-check" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
      <path d="M3.5 9.5L7 13l7.5-8"></path>
    </svg>
  </button>
  <span class="visually-hidden" role="status"></span>
</div>

<script>
  import { initEmailActions } from '../motion/email';

  initEmailActions();
</script>

<style>
  .email {
    position: relative;
  }

  a {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 1px solid rgb(243 243 241 / 30%);
    font-size: var(--size-contact-email);
  }

  .copy {
    position: absolute;
    left: 100%;
    top: 50%;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 16px;
    padding: 0;
    border: 1px solid rgb(243 243 241 / 28%);
    border-radius: 50%;
    background: rgb(6 6 7 / 18%);
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .copy[hidden] {
    display: none;
  }

  .copy:hover {
    opacity: 0.6;
  }

  svg {
    position: absolute;
    left: 12px;
    top: 12px;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 200ms ease,
      scale 250ms var(--ease-ui);
  }

  .icon-check,
  [data-copied] .icon-copy {
    opacity: 0;
    scale: 0.6;
  }

  [data-copied] .icon-check {
    opacity: 1;
    scale: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    svg {
      transition: none;
    }
  }
</style>
