---
/**
 * The contact, at the end of the journey, in the office (office spec §6): "Shall we talk?", the email with its
 * actions, LinkedIn, GitHub, the CV and Instagram. It is centred in the sky of the window, under the planet, where the
 * sky is darkest, with a light halo to keep it readable (back to the mockup's first layout, Grégoire's choice of
 * 3 November 2026).
 */
import { existsSync } from 'node:fs';
import EmailActions from './EmailActions.astro';
import Office from './Office.astro';
import { config } from '../config';
import { fragments, t, type Locale } from '../i18n';
import { withBase } from '../lib/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale);
// The CV joins the links once its PDF is in public/ (main spec §8.2).
const hasCv = existsSync(`public${config.cv}`);
// Each link shows its page on the office's screen when hovered (office spec §6).
const links = [
  { text: 'LinkedIn', href: config.links.linkedin, page: 'LinkedIn' },
  { text: 'GitHub', href: config.links.github, page: 'GitHub' },
  ...(hasCv ? [{ text: `${label('contact.cv')} (PDF)`, href: withBase(config.cv), page: 'CV' }] : []),
  { text: 'Instagram', href: config.links.instagram, page: 'Instagram' },
];
---

<section id={fragments.contact[locale]} class="contact" aria-labelledby="contact-label">
  <Office locale={locale} />
  <div class="text">
    <h2 id="contact-label" class="label">
      {label('contact.label')}
    </h2>
    <p class="title">{label('contact.title')}</p>
    <EmailActions locale={locale} />
    <ul class="links" aria-label={label('contact.links')}>
      {links.map(({ text, href, page }) => (
        <li>
          <a href={href} target="_blank" rel="noopener" data-screen-page={page}>
            {text} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    position: relative;
    min-height: max(100svh, 640px);
    overflow: hidden;
  }

  /* A shadow at the top keeps the header readable over the office; on mobile, one at the bottom frames the desk. */
  .contact::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 160px;
    background: linear-gradient(to bottom, rgb(6 6 7 / 45%), rgb(6 6 7 / 0%));
    pointer-events: none;
  }

  .text {
    position: absolute;
    z-index: 1;
    left: 49%;
    top: 152px;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 560px;
    text-align: center;
    translate: -50% 0;
  }

  .text::before {
    content: '';
    position: absolute;
    inset: -80px -110px;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, rgb(18 21 56 / 53%), rgb(0 0 0 / 0%));
    transform: translateY(30px);
  }

  :global(html[data-moment='aube']) .text::before {
    background: radial-gradient(closest-side, rgb(16 24 52 / 53%), rgb(0 0 0 / 0%));
  }

  .label {
    line-height: 16px;
    color: rgb(243 243 241 / 72%);
  }

  .title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: var(--size-contact-title);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }

  .text :global(.email) {
    margin-top: 28px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 24px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Narrower desktops bring the screen closer to the text: the links draw in. */
  @media (768px <= width < 1360px) {
    .links {
      gap: 0 16px;
    }
  }

  /* On small desktops the screen comes closer still: the text moves a little left, and the email and the title step
     down, the copy button clear of it. */
  @media (768px <= width < 1200px) {
    .text {
      left: 46%;
      --size-contact-title: 48px;
      --size-contact-email: 20px;
    }
  }

  @media (width < 768px) {
    .contact {
      min-height: max(100svh, 760px);
    }

    .contact::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: 0;
      height: 150px;
      background: linear-gradient(to top, rgb(6 6 7 / 55%), rgb(6 6 7 / 0%));
      pointer-events: none;
    }

    .text {
      left: 50%;
      top: 222px;
      width: 276px;
    }

    /* Its centre behind the email. */
    .text::before {
      inset: -60px -50px;
      transform: translateY(16px);
    }

    .title {
      margin-top: 12px;
    }

    .text :global(.email) {
      margin-top: 16px;
    }

    .links {
      gap: 0 14px;
      font-size: 14px;
    }

    .links a span {
      display: none;
    }
  }
</style>
