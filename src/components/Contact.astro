---
/**
 * The contact, at the end of the journey, in the office (office spec §6): "Shall we talk?", the email with its
 * actions, LinkedIn, GitHub, the CV and Instagram, then the copyright. On desktop the text sits on the left, over the
 * wall darkened by a halo; on mobile it is centred in the sky, under the planet.
 */
import { existsSync } from 'node:fs';
import EmailActions from './EmailActions.astro';
import Office from './Office.astro';
import { config } from '../config';
import { fragments, t, type Locale } from '../i18n';
import { withBase } from '../lib/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale);
// The CV joins the links once its PDF is in public/ (main spec §8.2).
const hasCv = existsSync(`public${config.cv}`);
// Each link shows its page on the office's screen when hovered (office spec §6).
const links = [
  { text: 'LinkedIn', href: config.links.linkedin, page: 'LinkedIn' },
  { text: 'GitHub', href: config.links.github, page: 'GitHub' },
  ...(hasCv ? [{ text: `${label('contact.cv')} (PDF)`, href: withBase(config.cv), page: 'CV' }] : []),
  { text: 'Instagram', href: config.links.instagram, page: 'Instagram' },
];
---

<section id={fragments.contact[locale]} class="contact" aria-labelledby="contact-label">
  <Office locale={locale} />
  <div class="text">
    <h2 id="contact-label" class="label">
      {label('contact.label')}
    </h2>
    <p class="title">{label('contact.title')}</p>
    <EmailActions locale={locale} />
    <ul class="links" aria-label={label('contact.links')}>
      {links.map(({ text, href, page }) => (
        <li>
          <a href={href} target="_blank" rel="noopener" data-screen-page={page}>
            {text} <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p class="copyright">© 2026 {config.name}</p>
</section>

<style>
  .contact {
    position: relative;
    min-height: max(100svh, 640px);
    overflow: hidden;
  }

  /* Shadows at the top and bottom keep the header and the copyright readable over the office. */
  .contact::before,
  .contact::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    pointer-events: none;
  }

  .contact::before {
    top: 0;
    height: 160px;
    background: linear-gradient(to bottom, rgb(6 6 7 / 45%), rgb(6 6 7 / 0%));
  }

  .contact::after {
    bottom: 0;
    height: 150px;
    background: linear-gradient(to top, rgb(6 6 7 / 55%), rgb(6 6 7 / 0%));
  }

  .text {
    position: absolute;
    z-index: 1;
    left: 112px;
    top: 43%;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 560px;
    translate: 0 -50%;
  }

  .text::before {
    content: '';
    position: absolute;
    inset: -120px -160px;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, rgb(18 21 56 / 62%), rgb(0 0 0 / 0%));
  }

  :global(html[data-moment='aube']) .text::before {
    background: radial-gradient(closest-side, rgb(16 24 52 / 62%), rgb(0 0 0 / 0%));
  }

  .label {
    line-height: 16px;
    color: rgb(243 243 241 / 72%);
  }

  .title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: var(--size-contact-title);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }

  .text :global(.email) {
    margin-top: 28px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .copyright {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    bottom: 24px;
    font-size: 13px;
    color: rgb(243 243 241 / 72%);
  }

  @media (width < 768px) {
    .contact {
      min-height: max(100svh, 760px);
    }

    .text {
      left: 50%;
      top: 222px;
      align-items: center;
      width: 276px;
      text-align: center;
      translate: -50% 0;
    }

    .text::before {
      inset: -60px -50px;
    }

    .title {
      margin-top: 12px;
    }

    .text :global(.email) {
      margin-top: 16px;
    }

    .links {
      justify-content: center;
      gap: 0 14px;
      font-size: 14px;
    }

    .links a span {
      display: none;
    }

    .copyright {
      left: 50%;
      translate: -50% 0;
      white-space: nowrap;
    }
  }
</style>
