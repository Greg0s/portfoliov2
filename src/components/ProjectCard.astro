---
/**
 * One project of the journey (journey spec §5): its cartel (title, tag, short description) and its card, a 16:9 link to
 * the case study. Its `id` is the project's slug, the fragment that leads to it in the home. Without the journey's
 * animation (no JavaScript, "reduce motion", the light version), the projects are a list, alternating sides; in the
 * journey, `src/scene/journey/journey.ts` places the card in 3D (`.place`), floats it (`.float`), turns it (`.spin`,
 * which carries the card and its shadow, `.shade`) and sets its focus.
 */
import { Image } from 'astro:assets';
import Cartel from './Cartel.astro';
import { pathFor, t, type Locale } from '../i18n';
import { projectTag, type Project } from '../lib/projects';
import { withBase } from '../lib/url';
import { slotAt } from '../scene/slots';

interface Props {
  locale: Locale;
  project: Project;
  index: number;
}

const { locale, project, index } = Astro.props;
const label = t(locale);
const { slug, data, text } = project;
const slot = slotAt(index);
const cartelId = `cartel-${slug}`;
const href = withBase(pathFor({ id: 'project', slug }, locale));
---

<li id={slug} class:list={['project', slot.side]} style={`--card-width: ${String(slot.width)}vw`} data-project={index}>
  <Cartel id={cartelId} title={text.data.title} tag={projectTag(project)} summary={text.data.summary} />
  <div class="place">
    <div class="float">
      <div class="spin">
        <span class="shade" aria-hidden="true"></span>
        <a class="card" href={href} aria-describedby={cartelId} data-slug={slug}>
          <Image
            src={data.cover}
            alt=""
            widths={[480, 720, 1120].filter((width) => width <= data.cover.width)}
            sizes="(width < 768px) 78vw, 38vw"
            fetchpriority="low"
            style={data.coverFocus ? `object-position: ${data.coverFocus}` : undefined}
          />
          <span class="visually-hidden">
            {label('card.see')} : {text.data.title}
          </span>
          <span class="pill" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 14 14">
              <path d="M4 10L10 4M5 4h5v5"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</li>

<style>
  .project {
    display: flex;
    align-items: center;
    gap: 48px;
    padding-block: 12vh;
    scroll-margin-top: 10vh;
  }

  .project.left {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }

  .project.right {
    justify-content: flex-end;
  }

  .place,
  .float,
  .spin {
    display: contents;
  }

  .shade {
    display: none;
  }

  .card {
    position: relative;
    display: block;
    flex: none;
    width: var(--card-width);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 55%),
      0 30px 80px -30px rgb(255 255 255 / 12%);
    transition: translate 450ms var(--ease-ui);
  }

  .card:hover {
    opacity: 1;
    translate: 0 -4px;
  }

  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* On phones, without hover: a round arrow in the card's corner, that says it opens. */
  .pill {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: rgb(12 12 13 / 78%);
    color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent-glow);
  }

  .pill svg {
    flex: none;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (width < 768px) {
    .project,
    .project.left,
    .project.right {
      flex-direction: column-reverse;
      align-items: center;
      gap: 24px;
      padding-block: 8vh;
    }

    .card {
      width: 78vw;
    }

    .pill {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }

  /* The journey (journey spec §4 and §5): the card in 3D at the vanishing point, its cartel beside it, on screen. */
  :global(html[data-journey='on']) .project {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  :global(html[data-journey='on']) .place {
    position: absolute;
    left: var(--vp-x);
    top: var(--vp-y);
    display: block;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  :global(html[data-journey='on']) .float {
    position: absolute;
    display: block;
    transform-style: preserve-3d;
  }

  /* Firefox: each card flattened into its own picture, with its own perspective (see `journey.ts`). */
  @supports (-moz-appearance: none) {
    :global(html[data-journey='on']) .float {
      transform-style: flat;
    }
  }

  /* The card's turn, on a point at the card's centre: the card and its shadow turn with it. */
  :global(html[data-journey='on']) .spin {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    width: 0;
    height: 0;
    transition: transform 450ms var(--ease-ui);
    backface-visibility: hidden;
  }

  /* The card's soft shadow, under the card and out of its blur: a blurred element is drawn again at every frame it
     moves, over all its shadow reaches; the shadow is blurred once, by the browser, as a shadow. */
  :global(html[data-journey='on']) .shade {
    position: absolute;
    display: block;
    border-radius: var(--radius-card);
    box-shadow: 0 40px 80px -24px rgb(0 0 0 / 75%);
    transition: box-shadow 450ms ease;
    pointer-events: none;
  }

  :global(html[data-journey='on']) .card {
    position: absolute;
    width: auto;
    box-shadow: 0 0 0 1px rgb(243 243 241 / 14%);
    pointer-events: auto;
    transition: box-shadow 450ms ease;
    translate: none;
  }

  :global(html[data-journey='on']) .project.lit .shade {
    box-shadow:
      0 50px 120px -24px rgb(255 255 255 / 10%),
      0 30px 60px -12px rgb(0 0 0 / 85%);
  }

  :global(html[data-journey='on']) .project.lit .card {
    box-shadow: 0 0 0 1px rgb(255 255 255 / 55%);
    cursor: none;
  }

  :global(html[data-journey='on']) .card:hover {
    opacity: inherit;
  }

  :global(html[data-journey='on']) .pill {
    display: inline-flex;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 300ms var(--ease-ui),
      translate 300ms var(--ease-ui);
  }

  @media (width < 768px) {
    :global(html[data-journey='on']) .project.lit .pill {
      opacity: 1;
      translate: 0 0;
    }

    :global(html[data-journey='on']) .project.lit .card {
      cursor: pointer;
    }
  }
</style>
