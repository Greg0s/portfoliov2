---
/**
 * "Next project" at the end of a case study (main spec §4): the case studies sit side by side, and the next one shows
 * at the page's right edge, its cover dimmed and fading in behind the text, the whole width of the page; the link slides
 * the page there (src/motion/slide.ts). The last one leads back to the first. Its cover is served as the next page's
 * opening media is, so that the page slides in with it already loaded.
 */
import { Image } from 'astro:assets';
import { pathFor, t, type Locale } from '../i18n';
import { captureAttributes, coverWidths, projectTag, type Project } from '../lib/projects';
import { withBase } from '../lib/url';

interface Props {
  locale: Locale;
  next: Project;
}

const { locale, next } = Astro.props;
const label = t(locale);
const href = withBase(pathFor({ id: 'project', slug: next.slug }, locale));
const capture = await captureAttributes(next.data, coverWidths, '100vw');
---

<nav class="next" aria-label={label('case.next')}>
  <a href={href} data-astro-prefetch="viewport">
    <span class="edge" aria-hidden="true">
      <Image
        src={next.data.cover}
        alt=""
        widths={coverWidths(next.data.cover)}
        sizes="100vw"
        style={next.data.coverFocus ? `object-position: ${next.data.coverFocus}` : undefined}
        {...capture}
      />
    </span>
    <span class="text">
      <span class="label">{label('case.next')}</span>
      <span class="title">
        {next.text.data.title}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </span>
      <span class="tag">{projectTag(next)}</span>
    </span>
  </a>
</nav>

<style>
  .next {
    position: relative;
    margin-top: 144px;
    border-top: 1px solid var(--color-line);
  }

  a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 340px;
    overflow: hidden;
  }

  a:hover {
    opacity: 1;
  }

  /* The next case study, waiting beside this one: its cover, dimmed, comes in from the right edge. */
  .edge {
    position: absolute;
    /* Wider than shown on its right: coming closer, it never uncovers the edge. */
    inset: 0 -32px 0 auto;
    width: calc(64% + 32px);
    opacity: 0.32;
    mask-image: linear-gradient(to right, transparent, #000 65%);
    transition:
      opacity 450ms ease,
      translate 600ms var(--ease-ui);
  }

  .edge img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 1100px;
    margin-inline: auto;
    padding: 64px var(--gutter);
    box-sizing: content-box;
    text-shadow: 0 2px 24px rgb(0 0 0 / 60%);
  }

  .label {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .title {
    display: flex;
    align-items: baseline;
    gap: 20px;
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-title);
  }

  .arrow {
    font-size: 0.8em;
    transition: translate 450ms var(--ease-ui);
  }

  .tag {
    font-family: var(--font-display);
    font-size: var(--size-tag);
    font-weight: 600;
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (hover: hover) {
    /* Pointed at, the next case study comes a little closer, and the arrow shows the way. */
    a:hover .edge,
    a:focus-visible .edge {
      opacity: 0.6;
      translate: -24px 0;
    }

    a:hover .arrow,
    a:focus-visible .arrow {
      translate: 10px 0;
    }
  }

  @media (width < 768px) {
    .next {
      margin-top: 96px;
    }

    a {
      min-height: 240px;
    }

    /* Narrower and darker on a phone, where the title runs over most of the width. */
    .edge {
      width: calc(64% + 32px);
      opacity: 0.28;
      mask-image: linear-gradient(to right, transparent, #000 80%);
    }

    .text {
      padding-block: 48px;
    }

    .title {
      gap: 14px;
      font-size: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge,
    .arrow {
      transition: none;
    }
  }
</style>
