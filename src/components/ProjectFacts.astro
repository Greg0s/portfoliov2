---
/**
 * The case study's facts (main spec §4, layout B of 2 November 2026): the button to the project's main link, its other
 * links, the year (or period), the role and the stack. A column of its own that stays in view beside the content on a
 * computer, the top of the content on a phone.
 */
import { t, type Locale } from '../i18n';
import type { Project } from '../lib/projects';
import { withBase } from '../lib/url';

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project } = Astro.props;
const label = t(locale);
const { year, stack, links, letter } = project.data;
const { period, role } = project.text.data;

/** The links in their order of importance: the first one present is the button, the others follow it. */
const kinds = [
  { key: 'live', button: label('case.link.live'), text: label('case.link.live') },
  { key: 'gallery', button: label('case.cta.gallery'), text: label('case.link.gallery') },
  { key: 'video', button: label('case.cta.video'), text: label('case.link.video') },
  { key: 'code', button: label('case.cta.code'), text: label('case.link.code') },
  { key: 'letter', button: label('case.cta.letter'), text: label('case.link.letter') },
] as const;
const hrefs: Partial<Record<(typeof kinds)[number]['key'], string | undefined>> = {
  ...links,
  ...(letter ? { letter: withBase(`letters/${project.slug}-${locale}.pdf`) } : {}),
};
const present = kinds.flatMap((kind) => {
  const href = hrefs[kind.key];
  return href ? [{ ...kind, href }] : [];
});
const [main, ...others] = present;
---

<aside class="facts" aria-label={label('case.facts')}>
  {main && (
    <a class="button pill-button" href={main.href} target="_blank" rel="noopener">
      {main.button}{' '}
      <span class="arrow-swap" aria-hidden="true">
        <span>↗</span>
        <span>↗</span>
      </span>
      <span class="visually-hidden">{label('case.newTab')}</span>
    </a>
  )}
  {others.length > 0 && (
    <p class="links">
      {others.map(({ href, text }) => (
        <a href={href} target="_blank" rel="noopener">
          {text} <span aria-hidden="true">↗</span>
          <span class="visually-hidden">{label('case.newTab')}</span>
        </a>
      ))}
    </p>
  )}
  <dl>
    <div>
      <dt>{label(period ? 'case.period' : 'case.year')}</dt>
      <dd>{period ?? year}</dd>
    </div>
    <div>
      <dt>{label('case.role')}</dt>
      <dd>{role}</dd>
    </div>
    <div>
      <dt>{label('case.stack')}</dt>
      <dd>
        <ul class="stack">
          {stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>
</aside>

<style>
  .facts {
    position: sticky;
    top: calc(var(--header-height) + 32px);
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--project-from), var(--project-to));
    color: var(--color-bg);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: 15px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: var(--color-muted);
  }

  .links a:hover {
    opacity: 1;
    color: var(--color-text);
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 12px 0 0;
  }

  dt {
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  dd {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 4px 10px;
    border-radius: 6px;
    background: rgb(243 243 241 / 6%);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 13px;
    line-height: 1.5;
    color: rgb(243 243 241 / 80%);
  }

  @media (width < 768px) {
    .facts {
      position: static;
    }
  }
</style>
