---
// A project's cartel (journey spec §5): title, tag, short description, at most 300 px wide, on the centre's side.
interface Props {
  id: string;
  title: string;
  tag: string;
  summary: string;
}

const { id, title, tag, summary } = Astro.props;
---

<div class="cartel" id={id}>
  <h3>{title}</h3>
  <p class="tag">{tag}</p>
  <p class="summary">{summary}</p>
</div>

<style>
  .cartel {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 300px;
  }

  /* The dark halo that keeps the cartel readable over the stars. */
  .cartel::before {
    content: '';
    position: absolute;
    inset: -64px -80px;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(6 6 7 / 78%), rgb(6 6 7 / 0%));
  }

  h3 {
    font-size: var(--size-project);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: var(--tracking-project);
  }

  .tag {
    font-family: var(--font-display);
    font-size: var(--size-tag);
    font-weight: 600;
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .summary {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  @media (width < 768px) {
    .cartel {
      align-items: center;
      text-align: center;
    }

    h3 {
      font-size: 24px;
    }
  }
</style>
