---
// The home page's three anchors, as plain sections until the static home (step 5) replaces them.
import Placeholder from './Placeholder.astro';
import { config } from '../config';
import { fragments, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale);
---

<Placeholder id={fragments.opening[locale]} label="Grégoire Tinnes">
  <h1 class="name">{config.name}</h1>
  <p class="tagline">{label('opening.tagline')}</p>
  <p class="lede">{label('site.description')}</p>
</Placeholder>
<Placeholder id={fragments.projects[locale]} label={label('nav.projects')}>
  <h2 class="label">{label('nav.projects')}</h2>
  <p class="lede">{label('placeholder.projects')}</p>
</Placeholder>
<Placeholder id={fragments.contact[locale]} label={label('nav.contact')}>
  <p class="label muted">{label('nav.contact')}</p>
  <h2 class="contact-title">{label('contact.title')}</h2>
  <a class="email" href={`mailto:${config.email}`}>
    {config.email}
  </a>
</Placeholder>

<style>
  .name {
    font-size: var(--size-name);
    line-height: 1;
  }

  .tagline {
    font-size: var(--size-tagline);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .lede {
    max-width: 36rem;
    color: var(--color-muted);
  }

  .muted {
    color: var(--color-muted);
  }

  .contact-title {
    font-size: var(--size-contact-title);
  }

  .email {
    font-size: var(--size-contact-email);
  }
</style>
