---
/**
 * The home (main spec §4, journey spec): the opening, the projects, then the contact in the office. Without
 * JavaScript and with "reduce motion", they follow one another as a list; with the journey (`src/scene/journey/`),
 * they share one scene on screen (`.stage`) while the page scrolls over a track as long as the journey (`SCREENS`).
 */
import Contact from './Contact.astro';
import Journey from './Journey.astro';
import Opening from './Opening.astro';
import { t, type Locale } from '../i18n';
import { SCREENS } from '../scene/journey/anchors';
import { applyJourneyMode } from '../scene/journey/mode';
// The ring's own styles, with the page's: a stylesheet a script brought would leave with the first page change.
import '../scene/showcase/showcase.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale);
// The journey or the list is decided before the first paint.
const modeScript = `(${applyJourneyMode.toString()})();`;
---

<script is:inline set:html={modeScript} />
<div class="home" data-journey-root>
  <div class="stage" data-stage>
    <Opening locale={locale} />
    <Journey locale={locale} />
    <Contact locale={locale} />
    <div class="cursor" data-cursor aria-hidden="true">
      <span>{label('card.see')}</span>
    </div>
    <div class="loading" aria-hidden="true">
      <span class="loading-ring"></span>
      <span class="loading-label">{label('journey.loading')}</span>
      <svg class="loading-b612" viewBox="0 0 32 32" width="48" height="48" shape-rendering="crispEdges">
        <path class="b612-fox" fill="#f7882f" d="M4 8h2v4h4V8h2v20H4z"></path>
        <path fill="#f5cb3a" d="M16 2h8v8h-8z"></path>
        <path fill="#e0a92a" d="M16 12h8v4h-8z"></path>
        <path class="b612-scarf" fill="#e0a92a" d="M24 12h6v4h-6z"></path>
        <path fill="#a9ce73" d="M16 16h8v12h-8z"></path>
        <circle cx="16" cy="46" r="22" fill="#aaa1a0"></circle>
        <path class="b612-star" fill="#ffffff" d="M29 3h2v2h-2z"></path>
      </svg>
    </div>
  </div>
  <div class="track" data-track aria-hidden="true" style={`--screens: ${String(SCREENS)}`}></div>
</div>

<script>
  import { initHome } from '../scene/journey/home';

  document.addEventListener('astro:page-load', initHome);
</script>

<style>
  .stage {
    display: contents;
  }

  .track,
  .cursor,
  .loading {
    display: none;
  }

  /* The journey: one scene on screen, the page scrolling over the track, snapped on the anchors. */
  :global(html[data-journey='on']) {
    scroll-snap-type: y mandatory;
    overflow-anchor: none;
  }

  :global(html[data-journey='on']) .stage {
    position: fixed;
    inset: 0;
    display: block;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% var(--vp-y-ratio, 50%), #0f0f11 0%, rgb(10 10 11 / 0%) 52%);
  }

  @media (width < 768px) {
    :global(html[data-journey='on']) .stage {
      --vp-y-ratio: 29%;
    }
  }

  :global(html[data-journey='on']) .stage > :global(*) {
    position: absolute;
    inset: 0;
  }

  /* Until the journey has drawn its first frame (and marked where it rests), the opening shows alone: the projects and
     the contact, stacked on it in the scene, wait for their places. */
  :global(html[data-journey='on']) .home:not([data-anchor]) .stage > :global(:not(.opening)) {
    visibility: hidden;
  }

  :global(html[data-journey='on']) .stage :global(.scene-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  :global(html[data-journey='on']) .track {
    position: relative;
    display: block;
    height: calc(var(--screens) * 100vh);
    pointer-events: none;
  }

  :global(html[data-journey='on']) .track :global(.journey-anchor) {
    position: absolute;
    left: 0;
    width: 1px;
    height: 1px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* The "See the project" disc, over the sharp card, on desktop: a gradient of the accent's blues only, from a turquoise-leaning blue, close to the job title's, to
     its sky blue, without its green (Grégoire's choice of 11 November 2026). */
  :global(html[data-journey='on']) .cursor {
    position: absolute;
    inset: auto;
    left: -48px;
    top: -48px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    padding: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, #5fb3d4, #71c4cf 50%, #90d3f4);
    color: var(--color-accent-ink);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    pointer-events: none;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 200ms ease,
      scale 300ms var(--ease-ui);
  }

  :global(html[data-journey='on']) .cursor:global(.on) {
    opacity: 1;
    scale: 1;
  }

  /* The loading pause (`journey.ts`): while a scene finishes getting ready, for a few seconds at most. It shows only
     past its first moments, so that a short pause never flashes. It sits just above the ring's arrows and counter
     (`showcase.css`), on a dark pill, so that neither they nor the text under it hide it. */
  :global(html[data-journey='on']) .loading {
    position: absolute;
    inset: auto auto calc(7vh + 52px + 20px) 50%;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 18px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgb(12 12 13 / 88%);
    color: var(--color-text);
    translate: -50% 0;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: var(--size-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  @media (width < 768px) {
    :global(html[data-journey='on']) .loading {
      bottom: calc(28px + 46px + 16px + env(safe-area-inset-bottom));
    }
  }

  :global(html[data-journey='on']) .home[data-loading] .loading {
    opacity: 1;
    transition-delay: 250ms;
  }

  /* On a phone too short to keep the ring's text clear of the pill (`fitRing`), the text fades out under it while it
     shows, with the same timing. The journey sets the cartels' own opacity frame by frame: their lines fade. */
  :global(html[data-journey='on']) .home[data-ring-tight] :global(.cartel > *) {
    transition: opacity 200ms ease;
  }

  :global(html[data-journey='on']) .home[data-ring-tight][data-loading] :global(.cartel > *) {
    opacity: 0;
    transition-delay: 250ms;
  }

  .loading-ring {
    width: 14px;
    height: 14px;
    border: 1.5px solid var(--color-line-strong);
    border-top-color: var(--color-text);
    border-radius: 50%;
    animation: loading-turn 900ms linear infinite;
  }

  .home:not([data-loading]) .loading-ring {
    animation-play-state: paused;
  }

  /* The loading pause's proposals (`src/motion/loading.ts`, `?chargement=1` to `5`): the pill gives way to them. */
  .loading-b612 {
    display: none;
  }

  :global(html[data-journey='on']) .home[data-loading-style] .loading {
    opacity: 0;
    transition: none;
  }

  :global(html[data-journey='on']) .home[data-ring-tight][data-loading-style] :global(.cartel > *) {
    opacity: 1;
    transition: none;
  }

  :global(html[data-journey='on']) .home[data-loading-style='5'] .loading {
    padding: 0;
    border: 0;
    background: none;
    transition: opacity 240ms ease;
  }

  :global(html[data-journey='on']) .home[data-loading-style='5'] .loading:global(.ls-on) {
    opacity: 1;
  }

  .home[data-loading-style] .loading-ring,
  .home[data-loading-style] .loading-label {
    display: none;
  }

  .home[data-loading-style='5'] .loading-b612 {
    display: block;
    overflow: hidden;
  }

  .home[data-loading-style='5'] .loading:global(.ls-on) .b612-scarf {
    animation: b612-scarf 600ms steps(1) infinite;
  }

  .home[data-loading-style='5'] .loading:global(.ls-on) .b612-star {
    animation: b612-star 1200ms steps(1) infinite;
  }

  .home[data-loading-style='5'] .loading:global(.ls-on) .b612-fox {
    animation: b612-fox 1800ms steps(1) infinite;
  }

  @keyframes b612-scarf {
    0% {
      transform: translate(0, 0);
    }

    25% {
      transform: translate(1px, -1px);
    }

    50% {
      transform: translate(2px, 0);
    }

    75% {
      transform: translate(1px, 1px);
    }
  }

  @keyframes b612-star {
    0% {
      opacity: 1;
    }

    50% {
      opacity: 0.25;
    }
  }

  @keyframes b612-fox {
    0% {
      transform: translate(0, 0);
    }

    85% {
      transform: translate(0, -1px);
    }
  }

  :global(.ls-layer) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.ls-wind) {
    position: absolute;
  }

  :global(.ls-grain) {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 1px;
    background: linear-gradient(to right, rgb(255 255 255 / 0%), rgb(255 255 255 / 90%));
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(.ls-star) {
    position: absolute;
    left: 0;
    top: 0;
    height: 1.5px;
    border-radius: 1px;
    background: linear-gradient(to right, rgb(255 255 255 / 0%), rgb(255 255 255 / 85%));
    transform-origin: 100% 50%;
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(.ls-star)::after {
    content: '';
    position: absolute;
    right: -1.5px;
    top: -1.5px;
    width: 4.5px;
    height: 4.5px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 8px 2px rgb(255 255 255 / 45%);
  }

  :global(.ls-comet) {
    position: absolute;
    inset: 0;
  }

  :global(.ls-comet-dot) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    will-change: transform, opacity;
  }

  :global(.ls-comet-head),
  :global(.ls-comet-tail) {
    position: absolute;
    left: -3px;
    top: -3px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  :global(.ls-comet-head) {
    background: #fff;
    box-shadow:
      0 0 8px 3px var(--color-accent),
      0 0 24px 8px color-mix(in srgb, var(--color-accent) 50%, transparent);
  }

  :global(.ls-sheen) {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  :global(.ls-sheen-band) {
    position: absolute;
    inset: -10% auto -10% 0;
    width: 32%;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0%),
      rgb(255 255 255 / 12%) 40%,
      rgb(255 255 255 / 22%) 50%,
      rgb(255 255 255 / 12%) 60%,
      rgb(255 255 255 / 0%)
    );
    transform: translateX(-130%);
    will-change: transform;
  }

  :global(.ls-line) {
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 72px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  :global(.cartel h3:has(.ls-line)) {
    position: relative;
  }

  @media (width >= 768px) {
    :global(.right .ls-line) {
      left: auto;
      right: 0;
      transform-origin: 100% 50%;
    }
  }

  @keyframes loading-turn {
    to {
      rotate: 1turn;
    }
  }
</style>
