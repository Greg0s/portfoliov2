---
import { fragments, pathFor, t, type Locale } from '../i18n';
import { withBase } from '../lib/url';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const label = t(locale);
const home = pathFor({ id: 'home' }, locale);
const anchor = (fragment: keyof typeof fragments): string => withBase(`${home}#${fragments[fragment][locale]}`);
---

<!-- motion/section.ts marks the current section (the opening, the projects or the contact): see the styles below. -->
<header class="header" data-site-header>
  <a class="label name" href={anchor('opening')} data-cut data-section-link="opening">
    Grégoire Tinnes
  </a>
  <nav class="links" aria-label={label('nav.label')}>
    <a href={anchor('projects')} data-cut data-section-link="projects">
      {label('nav.projects')}
    </a>
    <a href={anchor('contact')} data-cut data-section-link="contact">
      {label('nav.contact')}
    </a>
    <LanguageSwitch locale={locale} path={path} />
  </nav>
  <button class="menu-button" type="button" aria-haspopup="dialog" aria-expanded="false" data-menu-open>
    {label('menu.open')}
  </button>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    min-height: var(--header-height);
    padding-inline: var(--gutter);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 8px 32px;
    font-size: var(--size-nav);
    font-weight: 500;
  }

  /* Pointed at, the links take the accent rather than fading. */
  .name:hover,
  .links > a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .menu-button {
    display: none;
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    background: transparent;
    font-size: var(--size-nav);
    cursor: pointer;
    transition: opacity 200ms ease;
  }

  .menu-button:hover {
    opacity: 0.6;
  }

  @media (width < 768px) {
    .links {
      display: none;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
    }
  }
  /*
   * The current section, on a computer (Grégoire's choice, 3 November 2026): its link (the name on the opening)
   * glows softly in the accent, as if lit, and the other links dim a little. A phone shows no current section.
   */
  @media (width >= 768px) {
    [data-section] .name,
    [data-section] .links > a {
      color: rgb(243 243 241 / 68%);
      transition:
        color 600ms var(--ease-ui),
        text-shadow 600ms var(--ease-ui),
        opacity 200ms ease;
    }

    [data-section] .name[aria-current],
    [data-section] .links > a[aria-current],
    [data-section] .name:hover,
    [data-section] .links > a:hover {
      color: var(--color-accent);
    }

    [data-section] .name[aria-current],
    [data-section] .links > a[aria-current] {
      text-shadow:
        0 0 10px var(--color-accent-glow),
        0 0 22px var(--color-accent-soft);
    }
  }
</style>
