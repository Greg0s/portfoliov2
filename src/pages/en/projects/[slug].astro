---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { getProjects } from '../../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects('en');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project, projects } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project, projects } = Astro.props;
---

<CaseStudy locale="en" project={project} projects={projects} />
