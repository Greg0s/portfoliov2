---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import { alternate, defaultLocale, locales, t, type Locale } from '../i18n';
import { stripBase } from '../i18n';
import { withBase } from '../lib/url';
import { applyMoment } from '../scene/time';
import { fontFaceCss, preloadedFonts } from '../styles/fonts';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** False for a page with no equivalent in the other language (the 404): no canonical, no alternates. */
  indexable?: boolean;
}

const { locale, title, description, indexable = true } = Astro.props;
const label = t(locale);
const path = indexable ? stripBase(Astro.url.pathname) : '/';
const absolute = (sitePath: string): string => new URL(withBase(sitePath), Astro.site).href;
const alternates = locales.map((lang) => ({ lang, href: absolute(lang === locale ? path : alternate(path, lang)) }));
const xDefault = alternates.find(({ lang }) => lang === defaultLocale)?.href;
// The moment is set before the first paint, from the same function the tests cover.
const momentScript = `(${applyMoment.toString()})();`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0d" />
    {indexable ? (
      <>
        <link rel="canonical" href={absolute(path)} />
        {alternates.map(({ lang, href }) => (
          <link rel="alternate" hreflang={lang} href={href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    {preloadedFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontFaceCss} />
    <script is:inline set:html={momentScript} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      {label('skip.content')}
    </a>
    {/* A case study brings its own header in this slot; every other page has the site's header and menu. */}
    <slot name="header">
      <Header locale={locale} path={path} />
      <Menu locale={locale} path={path} />
    </slot>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <div class="veil" aria-hidden="true" data-veil transition:persist="veil"></div>
  </body>
</html>

<script>
  import { initMenu } from '../motion/menu';
  import { initNav } from '../motion/nav';
  import { applyMoment, onMomentChange } from '../scene/time';

  // Module scripts run once per visit; the client router keeps the document, so delegated listeners stay.
  initMenu();
  initNav();
  // The router swaps the root element's attributes for the new page's: the moment is set again on each page.
  document.addEventListener('astro:after-swap', applyMoment);
  onMomentChange((moment) => {
    document.documentElement.dataset.moment = moment;
  });
</script>

<style>
  main:focus {
    outline: none;
  }
</style>
