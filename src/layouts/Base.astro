---
import { withBase } from '../lib/url';

// Skeleton layout (step 2). Step 3 adds the design tokens, fonts, header, hreflang and the client router.
interface Props {
  lang: 'fr' | 'en';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <main id="contenu">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    background: #0c0c0d;
    color: #f3f3f1;
    font-family: system-ui, sans-serif;
  }

  body {
    min-height: 100svh;
    margin: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(#0c0c0d, #060607);
  }

  main {
    max-width: 40rem;
    padding: 2rem 1rem;
    text-align: center;
  }

  a {
    color: #fff;
  }

  a:hover {
    opacity: 0.6;
  }

  a:focus-visible {
    outline: 2px solid #f3f3f1;
    outline-offset: 2px;
  }

  p {
    color: #8f8f8b;
  }
</style>
