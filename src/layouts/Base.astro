---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import { config } from '../config';
import { alternate, defaultLocale, locales, t, type Locale } from '../i18n';
import { stripBase } from '../i18n';
import { ogLocales, SHARE_SIZE } from '../lib/share';
import { withBase } from '../lib/url';
import { applyMoment } from '../scene/time';
import { fontFaceCss, preloadedFonts } from '../styles/fonts';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** False for a page with no equivalent in the other language (the 404): no canonical, no alternates. */
  indexable?: boolean;
  /** What a shared link shows (Open Graph, Twitter): its image, a site path under `public/`, and that image's text. */
  share?: { image: string; alt: string; type?: 'website' | 'article' };
  /** The page's schema.org description, written as JSON-LD. */
  structuredData?: Record<string, unknown>;
}

const { locale, title, description, indexable = true, share, structuredData } = Astro.props;
const label = t(locale);
const path = indexable ? stripBase(Astro.url.pathname) : '/';
const absolute = (sitePath: string): string => new URL(withBase(sitePath), Astro.site).href;
const alternates = locales.map((lang) => ({ lang, href: absolute(lang === locale ? path : alternate(path, lang)) }));
const xDefault = alternates.find(({ lang }) => lang === defaultLocale)?.href;
const shareImage = share ? absolute(share.image) : undefined;
// Escapes "<" so that no text in the data can close the script element.
const jsonLd = structuredData ? JSON.stringify(structuredData).replaceAll('<', '\\u003c') : undefined;
// The moment is set before the first paint, from the same function the tests cover.
const momentScript = `(${applyMoment.toString()})();`;
// Measurement switches (`?ombres=0`, `?fond=0`): the page without the cards' large shadows, or without its gradient,
// to tell what each costs on a browser that draws the ring slowly (see `src/styles/base.css`).
const switchesScript = `(() => { const asked = new URLSearchParams(location.search); for (const name of ['ombres', 'fond']) if (asked.get(name) === '0') document.documentElement.setAttribute('data-sans-' + name, ''); if (asked.get('ombre') === 'legere') document.documentElement.setAttribute('data-ombre-legere', ''); })();`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0c0d" />
    {indexable ? (
      <>
        <link rel="canonical" href={absolute(path)} />
        {alternates.map(({ lang, href }) => (
          <link rel="alternate" hreflang={lang} href={href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefault} />
        <meta property="og:site_name" content={config.name} />
        <meta property="og:type" content={share?.type ?? 'website'} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={absolute(path)} />
        <meta property="og:locale" content={ogLocales[locale]} />
        {locales
          .filter((lang) => lang !== locale)
          .map((lang) => (
            <meta property="og:locale:alternate" content={ogLocales[lang]} />
          ))}
        {share && (
          <>
            <meta property="og:image" content={shareImage} />
            <meta property="og:image:type" content="image/jpeg" />
            <meta property="og:image:width" content={String(SHARE_SIZE.width)} />
            <meta property="og:image:height" content={String(SHARE_SIZE.height)} />
            <meta property="og:image:alt" content={share.alt} />
          </>
        )}
        <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
        {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {preloadedFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontFaceCss} />
    <script is:inline set:html={momentScript} />
    <script is:inline set:html={switchesScript} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      {label('skip.content')}
    </a>
    {/* A case study brings its own header in this slot; every other page has the site's header and menu. */}
    <slot name="header">
      <Header locale={locale} path={path} />
      <Menu locale={locale} path={path} />
    </slot>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <div class="veil" aria-hidden="true" data-veil transition:persist="veil"></div>
  </body>
</html>

<script>
  import { initDive } from '../motion/dive';
  import { initLanguage } from '../motion/language';
  import { initMenu } from '../motion/menu';
  import { initNav } from '../motion/nav';
  import { initNote } from '../motion/note';
  import { initSlide } from '../motion/slide';
  import { initSwipe } from '../motion/swipe';
  import { initSection } from '../motion/section';
  import { applyMoment, onMomentChange } from '../scene/time';

  // Module scripts run once per visit; the client router keeps the document, so delegated listeners stay.
  initMenu();
  initNav();
  initNote();
  initDive();
  initSlide();
  initSwipe();
  initLanguage();
  initSection();
  // The router swaps the root element's attributes for the new page's: the moment is set again on each page.
  document.addEventListener('astro:after-swap', applyMoment);
  onMomentChange((moment) => {
    document.documentElement.dataset.moment = moment;
  });
</script>

<style>
  main:focus {
    outline: none;
  }
</style>
